# Copier en .env (non commité) ou exporter ces variables avant "mvn spring-boot:run"
DB_URL=jdbc:mysql://localhost:3306/healthcare_companion?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=healthcare_user
DB_PASSWORD=change_me

# openssl rand -base64 32
JWT_SECRET=remplacer_par_une_cle_base64_de_32_octets_minimum

# Compte administrateur créé au premier démarrage (si aucun admin n'existe)
ADMIN_EMAIL=admin@healthcare.local
ADMIN_PASSWORD=Admin12345

# Mot de passe des comptes de démonstration (profil dev)
DEMO_PASSWORD=Demo12345
